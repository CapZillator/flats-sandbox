{
  "name": "flats-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --port 3001",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && eslint . --fix && prettier --write .",
    "format:check": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "keen-slider": "^6.8.6",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.89.0",
    "react-sortablejs": "^6.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
